{
  "name": "knitplot",
  "version": "0.1.0",
  "description": "A local-first colourwork chart maker with image conversion, knitted previews, instructions, Knit Mode, and optional OpenAI features.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "scripts": {
    "dev": "next dev",
    "db:migrate": "node-pg-migrate --migrations-dir database/migrations up",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts",
    "test:db": "node --import tsx --test database/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}

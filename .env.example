# Hosted accounts (Clerk) and private chart storage (Neon)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# Required to enable guest chart links on Vercel after migration 013.
# Set a random secret (at least 32 characters); never prefix with NEXT_PUBLIC_.
KNITPLOT_LINK_RATE_SECRET=
# Optional: Clerk user ID authorized to review /chart-club/moderation.
# Reports appear in the queue only; no email or push notification is sent.
CHART_CLUB_MODERATOR_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Formspree form ID for chart maker feedback; configure the inbox in Formspree.
KNITPLOT_FEEDBACK_FORM_ID=
